{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Deep Dive: LeRobot v3.0 (pusht)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["deep", "lerobot_v3", "-n", "30"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "1b. Deep Dive: LeRobot v3.0 HD Dual-Cam SO-100 (CPU vs RTX NVDEC)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["lerobot-hd", "-n", "40"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "2. Deep Dive: RLDS / TFRecord (CRC32C + Protobuf + Read-Amp)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["deep", "rlds", "-n", "20"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "3. Deep Dive: HDF5 / robomimic (Superblock + B-Tree + MuJoCo XML)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["deep", "hdf5", "-n", "100"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "4. Deep Dive: Zarr / Diffusion Policy (Blosc + Read-Amp + Workers)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["deep", "zarr", "-n", "40"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "5. Deep Dive: ROS 2 bag / MCAP (Chunks + Raw CDR Decode + Clock Skew)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["deep", "mcap"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "6. 3-Layer Anatomy (Pick Format)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["anatomy", "${input:datasetFormat}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "7. HF Hub Cache Anatomy (~/.cache/huggingface/hub)",
      "type": "debugpy",
      "request": "launch",
      "module": "embodied_formats.cli",
      "args": ["hf-cache"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "8. Pytest (All Tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "-s"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "9. Current Python File (Step into 3rd-party Libs)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    }
  ],
  "inputs": [
    {
      "id": "datasetFormat",
      "type": "pickString",
      "description": "Select Embodied AI dataset format",
      "options": ["lerobot_v3", "rlds", "hdf5", "zarr", "mcap"],
      "default": "lerobot_v3"
    }
  ]
}
